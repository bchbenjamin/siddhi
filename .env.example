APP_ENV=development
APP_NAME=Siddhi
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://siddhi_user:siddhi_password@127.0.0.1:5432/siddhi
SECRET_KEY=GENERATE_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_MINUTES=20
SESSION_REFRESH_DAYS=7
FRONTEND_ORIGIN=http://127.0.0.1:5173
# JSON array when deploying, for example ["https://your-app.vercel.app"]
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_SIZE_MB=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend deployment
# Leave empty for the local Vite proxy. Set this to the deployed API origin
# plus /api/v1 when hosting the frontend separately on Vercel.
NEXT_PUBLIC_API_BASE_URL=

# Next.js server-side API bridge. Use the FastAPI origin in local/deployed environments.
BACKEND_URL=http://127.0.0.1:8000
