APP_ENV=development
APP_NAME=Siddhi
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://siddhi_user:siddhi_password@127.0.0.1:5432/siddhi
SECRET_KEY=GENERATE_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_MINUTES=20
SESSION_REFRESH_DAYS=7
FRONTEND_ORIGIN=http://localhost:3000
# JSON array when deploying, for example ["https://your-app.vercel.app"]
ALLOWED_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_SIZE_MB=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Next.js server-side API bridge. The browser always calls same-origin /api/v1.
# Set this to the FastAPI origin in local/deployed environments.
BACKEND_URL=http://127.0.0.1:8000
